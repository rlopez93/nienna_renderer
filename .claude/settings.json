{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake *)",
      "Bash(ninja *)",
      "Bash(ctest *)",
      "Bash(clang-format *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(./build/debug/nienna)",
      "Bash(./build/debug/nienna *)",
      "Bash(./build/release/nienna)",
      "Bash(./build/release/nienna *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git submodule update --remote*)",
      "Bash(rm -rf *)",
      "Edit(./third_party/**)",
      "Edit(./include/stb_image.h)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.cpp|*.hpp|*.h|*.c) clang-format -i \"$f\" ;; esac; }"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\"; [ -n \"$VULKAN_SDK\" ] || echo 'WARNING: VULKAN_SDK is not set; source the Vulkan SDK setup-env.sh before building.'; [ -f third_party/fastgltf/CMakeLists.txt ] || echo 'WARNING: submodules are not initialized; run git submodule update --init --recursive.'; exit 0"
          }
        ]
      }
    ]
  }
}
